# @BotFather'dan olingan bot tokeni
BOT_TOKEN=

# Mini App joylashgan https manzil (masalan: https://sizning-domen.uz)
# Telegram Mini App faqat HTTPS orqali ishlaydi, localhost bilan ishlamaydi!
WEB_APP_URL=

# Buyurtma xabarlari shu chatga boradi — shaxsiy chat ID yoki GURUH ID bo'lishi mumkin
# Guruh ID'sini bilish uchun: guruh yarating, botni admin qilib qo'shing, guruhda /groupid deb yozing
ADMIN_CHAT_ID=

# (ixtiyoriy, hozircha ishlatilmaydi — parolga asoslangan tizimga o'tildi)
ADMIN_TELEGRAM_ID=

# To'lov qabul qilinadigan karta raqami — mijozlarga webapp'da va tasdiqlash xabarida ko'rsatiladi
PAYMENT_CARD_NUMBER=
# Karta egasining ismi (ixtiyoriy, lekin tavsiya etiladi)
PAYMENT_CARD_OWNER=

# Admin panelga (/admin) kirish paroli — statistika, barcha buyurtmalar, oflayn kiritish
# O'zingiz o'ylab toping, boshqa hech kimga bermang
ADMIN_PANEL_PASSWORD=

# Xodim uchun parol (/xodim) — FAQAT oflayn bandlik kiritish huquqi beradi,
# statistika va buyurtmalar ro'yxatini ko'ra olmaydi. Ishchiga shu parolni bering.
STAFF_PASSWORD=

# Ma'lumotlar saqlanadigan papka. Railway'da "Volume" (doimiy xotira) yaratib,
# shu yerga uning yo'lini ko'rsating — aks holda har safar qayta deploy qilganda
# (yangi kod yuklaganingizda) MIJOZLAR MA'LUMOTI O'CHIB KETADI!
# Railway'da: loyihangizga "Volume" qo'shing (masalan /data ga bog'lang), keyin shu yerga yozing:
DATA_DIR=/data

PORT=3000
