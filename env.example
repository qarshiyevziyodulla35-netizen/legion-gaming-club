# @BotFather'dan olingan bot tokeni
BOT_TOKEN=

# Mini App joylashgan https manzil (masalan: https://sizning-domen.uz)
# Telegram Mini App faqat HTTPS orqali ishlaydi, localhost bilan ishlamaydi!
WEB_APP_URL=

# Buyurtma xabarlari shu chatga boradi — shaxsiy chat ID yoki GURUH ID bo'lishi mumkin
# Guruh ID'sini bilish uchun: guruh yarating, botni admin qilib qo'shing, guruhda /groupid deb yozing
ADMIN_CHAT_ID=

# Sizning SHAXSIY Telegram ID raqamingiz — /admin va /stats buyruqlari, hamda admin panelga
# kirish huquqi shu ID orqali beriladi (guruh ID emas, shaxsiy chat ID)
# Buni bilish uchun botning shaxsiy chatida /groupid deb yozing
ADMIN_TELEGRAM_ID=

PORT=3000
